{
  "name": "music-caption-video",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "web": "node web/server.mjs",
    "setup-whisper": "python3 -m venv .whisper-env && .whisper-env/bin/pip install faster-whisper==1.2.1",
    "preview": "remotion studio --no-open",
    "render": "remotion render MusicCaption outputs/music-video.mp4 --codec=h264 --audio-codec=aac",
    "render:proxy": "remotion render MusicCaption outputs/music-video-proxy.mp4 --codec=h264 --audio-codec=aac --scale=0.5 --crf=28 --x264-preset=veryfast --audio-bitrate=128k",
    "check": "tsc --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "^5.2.8",
    "@remotion/captions": "4.0.506",
    "@remotion/cli": "4.0.506",
    "@remotion/media": "4.0.506",
    "mediabunny": "^1.34.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.506"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  }
}
